OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_USER_AGENT=ResumeFlowAI/0.1
OPENAI_TIMEOUT_SECONDS=45

# Optional local LibreOffice path. Docker/Render sets this automatically.
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# Optional application log level: DEBUG, INFO, WARNING, or ERROR.
# LOG_LEVEL=INFO
# Optional when the API requires a local proxy.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost
